# Aim the lamp's head (motion_node). It keeps aiming there while the body moves.
#   mode "point": at (x, y, z) in base_link, metres
#   mode "angle": yaw / pitch degrees; yaw + = lamp's left, pitch + = up, 0 = level
string mode
float64 x
float64 y
float64 z
float64 yaw
float64 pitch
---
bool success
string message
uint32 goal_id   # matches MotionState.goal_id once motion_node is working on it
